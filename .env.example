# Profile switch: 'cloud' (Azure OpenAI) or 'local' (Ollama)
LLM_PROFILE=cloud

# Azure OpenAI (used when LLM_PROFILE=cloud)
AZURE_OPENAI_API_KEY=API_KEY
AZURE_OPENAI_ENDPOINT=ENDPOINT
API_VERSION=VERSION
AZURE_OPENAI_DEPLOYMENT=CHAT_DEPLOYMENT
AZURE_OPENAI_EMBEDDING=TEXT_EMBEDDING

# Ollama (used when LLM_PROFILE=local)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_LLM_MODEL=gemma4:e4b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# RAG - Semantic Chunking Settings
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP_SENTENCES=2
RAG_TOP_K=5
RAG_USE_QUERY_EXPANSION=true

# Vector DB - separate collections per profile to keep dimensions clean
CHROMA_PERSIST_DIR=./chroma_db
CLOUD_COLLECTION_NAME=water_rag
LOCAL_COLLECTION_NAME=water_rag_local

# Agent
MAX_TOOL_ITERATIONS=3
LLM_TEMPERATURE=0.7

# Logging
LOG_LEVEL=INFO