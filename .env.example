# ----------------------------------------------------------------------
# LLM Profile Switch
# ----------------------------------------------------------------------
# Selects which backend the agent + embedder use.
#   cloud -> Azure OpenAI (gpt-5.4-nano + text-embedding-3-small, 1536 dims)
#   local -> Ollama (gemma3:e4b + nomic-embed-text, 768 dims)
# Both profiles must remain runnable; the only change between them is
# client construction. See docs/local-mode-comparison.md.
LLM_PROFILE=cloud

# ----------------------------------------------------------------------
# Cloud profile - Azure OpenAI
# ----------------------------------------------------------------------
AZURE_OPENAI_API_KEY= API_KEY
AZURE_OPENAI_ENDPOINT= ENDPOINT
API_VERSION= VERSION
AZURE_OPENAI_DEPLOYMENT= CHAT_DEPLOYMENT
AZURE_OPENAI_EMBEDDING= TEXT_EMBEDDING

# ----------------------------------------------------------------------
# Local profile - Ollama (OpenAI-compatible endpoint)
# ----------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_CHAT_MODEL=gemma3:e4b
OLLAMA_EMBED_MODEL=nomic-embed-text

# RAG - Semantic Chunking Settings
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP_SENTENCES=2
RAG_TOP_K=5
RAG_USE_QUERY_EXPANSION=true

# Vector DB
# Cloud and local use separate collections because embedding dims differ
# (1536 for text-embedding-3-small vs 768 for nomic-embed-text). Querying
# a 1536-dim collection with a 768-dim vector silently returns garbage.
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_CLOUD=water_rag
CHROMA_COLLECTION_LOCAL=water_rag_local

# Agent
MAX_TOOL_ITERATIONS=3
LLM_TEMPERATURE=SET_TEMPERATURE

# Logging
LOG_LEVEL=INFO
