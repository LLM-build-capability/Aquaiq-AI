{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "rootDir": ".",
    "skipLibCheck": true
  },
  "include": [
    "shared/**/*.ts",
    "registry/**/*.ts",
    "orchestrator/**/*.ts",
    "mcp-agent/main.ts"
  ]
}
